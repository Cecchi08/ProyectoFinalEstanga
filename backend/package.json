{
  "name": "venti-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.js",
    "build": "npm run check && tsc",
    "check": "tsc --noEmit && node scripts/check.js",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.0.13",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
