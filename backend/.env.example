NODE_ENV=development
PORT=3000

# Conexión única y directa a MySQL (Vercel Serverless y local) mediante MYSQL_PUBLIC_URL.
# No existen variables alternativas ni fallbacks (no usar MYSQLHOST/MYSQL_HOST/DATABASE_URL).
# Aiven exige TLS con su CA: agregá ?ssl=true a la URL y configurá el certificado CA más abajo
# (MYSQL_SSL_CA_PATH con la ruta local del ca.pem, o MYSQL_SSL_CA con el PEM en línea).
MYSQL_PUBLIC_URL=mysql://USER:PASSWORD@HOST:PORT/venti?ssl=true
DB_CONNECTION_LIMIT=5

# TLS/CA del proveedor. Aiven entrega un ca.pem por proyecto: usar UNA de las dos opciones.
# El archivo ca.pem NO debe subirse al repositorio ni compartirse.
MYSQL_SSL_CA_PATH=C:/ruta/a/ca.pem
# MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<secreto-jwt-minimo-48-caracteres>
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=venti-api
JWT_AUDIENCE=venti-client
REFRESH_TOKEN_EXPIRES_DAYS=30
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Origen del frontend en Vercel (también se acepta localhost automáticamente)
FRONTEND_URL=https://venti-web-ejemplo.vercel.app
# Alternativa o extra: CORS_ORIGINS=https://venti-web-ejemplo.vercel.app
# 0 sin proxy; ajustar solo para una topología de proxies confiable (ej. TRUST_PROXY_HOPS=1 detrás de un proxy propio).
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@venti.example
EMAIL_VERIFY_URL=http://localhost:8081/verify-email
PASSWORD_RESET_URL=http://localhost:8081/reset-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
FACEBOOK_GRAPH_VERSION=v23.0
APP_DEEP_LINK=venti://oauth-callback
WEB_OAUTH_REDIRECT_URL=http://localhost:8081/oauth-callback

# Pruebas: MySQL 8 local aislada (compose.test.yml). Nunca apuntar a producción ni a la base de datos real.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=33316
TEST_DB_USER=root
TEST_DB_PASSWORD=<password-de-la-mysql-de-pruebas>
