NODE_ENV=development
PORT=3000

# Railway: preferir MYSQL_PUBLIC_URL desde fuera del proyecto o MYSQL_URL dentro.
MYSQL_PUBLIC_URL=mysql://USER:PASSWORD@HOST:PORT/venti
MYSQL_URL=mysql://USER:PASSWORD@HOST:PORT/venti
# Alternativa por variables Railway o desarrollo local.
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=venti_app
MYSQLPASSWORD=NUlAFNbbGvbsHPOPkPtwqMDTZpALEUlG
# An explicit database name overrides the URL path (Railway URLs may use /railway).
MYSQLDATABASE=venti
# Alternativas admitidas: MYSQL_DATABASE o DB_HOST, DB_PORT, DB_USER,
# DB_PASSWORD y DB_NAME. No usar MYSQL_ROOT_PASSWORD como secreto de la API.
DB_CONNECTION_LIMIT=10

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=eb0b19e33f3da0b3ac1dd9b270041b88ef34a197de753574352f522f967b8ebc92a8e6edbcd3840c30500c0fbcf6df71
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=venti-api
JWT_AUDIENCE=venti-client
REFRESH_TOKEN_EXPIRES_DAYS=30
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# 0 sin proxy; ajustar solo para una topología de proxies confiable.
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@venti.example
EMAIL_VERIFY_URL=http://localhost:8081/verify-email
PASSWORD_RESET_URL=http://localhost:8081/reset-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
FACEBOOK_GRAPH_VERSION=v23.0
APP_DEEP_LINK=venti://oauth-callback
WEB_OAUTH_REDIRECT_URL=http://localhost:8081/oauth-callback
