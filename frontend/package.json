{
  "name": "venti-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && eslint --config eslint.config.mjs frontend/src frontend/app frontend/tests --max-warnings 0",
    "lint:backend": "cd .. && eslint --config eslint.config.mjs backend/src backend/tests backend/scripts --max-warnings 0",
    "build": "expo export --platform web",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.10",
    "eslint": "^10.12.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
