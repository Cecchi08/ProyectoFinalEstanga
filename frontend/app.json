{
  "expo": {
    "name": "VENTI",
    "slug": "venti",
    "scheme": "venti",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a VENTI escanear entradas QR.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "VENTI"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.venti.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.venti.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f344811-5556-421e-aa91-60d4dfed8f7e"
      }
    }
  }
}
